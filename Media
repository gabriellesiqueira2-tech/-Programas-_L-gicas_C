#include<stdio.h>

int main() {
    int quantidade, i;
    float nota, soma = 0, media;

    printf("Quantas notas voce deseja calcular? ");
    scanf("%d", &quantidade);

    if (quantidade <= 0) {
        printf("Quantidade invalida! Digite um numero maior que zero.\n");
    }

    for (i = 1; i <= quantidade; i++) {
        printf("Digite a nota %d: ", i);
        scanf("%f", &nota);
        soma += nota; // O mesmo que: soma = soma + nota
    }

    media = soma / quantidade;

    printf("\nA media final e: %.2f\n", media);

    if (media >= 7.0) {
        printf("Situacao: Aprovado!\n");
    } else {
        printf("Situacao: Reprovado.\n");
    }

    return 0;
}
